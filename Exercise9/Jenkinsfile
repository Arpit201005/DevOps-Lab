
pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Installing Python dependencies...'
                sh '''
                    python3 --version
                    python3 -m venv .venv
                    .venv/bin/pip install --upgrade pip
                    .venv/bin/pip install -r requirements.txt
                '''
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                sh '.venv/bin/python -m unittest discover -s . -v'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                sh '''
                    mkdir -p "$WORKSPACE/python-app-deploy"
                    cp app.py "$WORKSPACE/python-app-deploy/"
                    cp requirements.txt "$WORKSPACE/python-app-deploy/"
                    echo "Application files copied successfully."
                '''
            }
        }

        stage('Run Application') {
            steps {
                echo 'Starting Flask application...'
                sh '''
                    if [ -f "$WORKSPACE/python-app-deploy/app.pid" ] &&
                       kill -0 "$(cat "$WORKSPACE/python-app-deploy/app.pid")" 2>/dev/null; then
                        kill "$(cat "$WORKSPACE/python-app-deploy/app.pid")"
                    fi

                    nohup "$WORKSPACE/.venv/bin/python" \
                        "$WORKSPACE/python-app-deploy/app.py" \
                        > "$WORKSPACE/python-app-deploy/app.log" 2>&1 &

                    echo $! > "$WORKSPACE/python-app-deploy/app.pid"
                    sleep 3

                    if ! kill -0 "$(cat "$WORKSPACE/python-app-deploy/app.pid")" 2>/dev/null; then
                        cat "$WORKSPACE/python-app-deploy/app.log"
                        exit 1
                    fi
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Checking the running application...'
                sh '''
                    .venv/bin/python -c "
import urllib.request
response = urllib.request.urlopen('http://127.0.0.1:5000/', timeout=5)
body = response.read().decode()
print(body)
assert response.status == 200
assert body == 'Hello, Jenkins Multi-Stage Pipeline!'
"
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the Console Output.'
        }
    }
}
